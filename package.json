{
  "name": "agent-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "description": "Interactive playground for agentfootprint — run samples, see conversations, inspect metrics",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "test": "vitest run",
    "test:types": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module ESNext --moduleResolution bundler --jsx react-jsx --types vite/client test/captured-execution.test.ts",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.10.1",
    "agentfootprint": "file:../agentfootprint",
    "agentfootprint-lens": "file:../agentfootprint-lens",
    "footprint-explainable-ui": "file:../explainable-ui",
    "footprintjs": "file:../footPrint",
    "foottrace": "^1.0.0",
    "highlight.js": "^11.11.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.10.0",
    "react-router-dom": "^7.13.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sucrase": "^3.35.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "jsdom": "^29.0.1",
    "typescript": "~5.4.5",
    "typescript-eslint": "^8.48.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.5"
  }
}
